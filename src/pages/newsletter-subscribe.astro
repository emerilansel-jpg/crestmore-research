---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Subscribed — Crestmore Research"
  description="Thank you for subscribing to the Crestmore Research Weekly Intelligence Briefing."
  pageType="default"
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <p class="section__eyebrow section__eyebrow--gold">Subscription Received</p>
        <h1 class="page-hero__title">Thank You for Subscribing</h1>
        <p class="page-hero__sub">You have been added to the Weekly Intelligence Briefing list. Expect your first briefing next Friday.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="thank-you-box">
        <p class="thank-you-text">
          Confirmation sent to <strong id="sub-email">your email</strong>.
          If you do not see it, please check your spam folder or contact us at
          <a href="mailto:research@crestmoreresearch.com">research@crestmoreresearch.com</a>.
        </p>
        <a href="/insights" class="btn btn--gold">Read latest insights</a>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const params = new URLSearchParams(window.location.search);
      const email = params.get('email');
      if (email) {
        const el = document.getElementById('sub-email');
        if (el) el.textContent = email;
      }
    })();
  </script>
</BaseLayout>

<style>
.thank-you-box {
  max-width: 640px;
  margin: 0 auto;
  text-align: center;
  padding: 48px 32px;
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.thank-you-text {
  font-family: 'Inter', sans-serif;
  font-size: 16px;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 32px;
}

.thank-you-text a {
  color: var(--accent);
  text-decoration: underline;
}

@media (max-width: 600px) {
  .thank-you-box { padding: 32px 24px; }
}
</style>
