---
// 404.astro — Custom not found page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Crestmore Research"
  description="The page you requested could not be found."
  noindex={true}
>
  <section class="section" aria-labelledby="not-found-title">
    <div class="container" style="text-align: center; padding: 120px 24px;">
      <h1 id="not-found-title" style="font-size: 3rem; margin-bottom: 1rem;">Page Not Found</h1>
      <p style="color: var(--text-muted); font-size: 1.125rem; margin-bottom: 2rem;">
        The page you are looking for does not exist or has been moved.
      </p>
      <a href="/" class="btn" style="display: inline-block;">Back to Home</a>
    </div>
  </section>
</BaseLayout>
